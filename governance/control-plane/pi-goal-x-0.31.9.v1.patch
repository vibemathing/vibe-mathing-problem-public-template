@@ -0,0 +1,74 @@
+// MIT; 仅连接通用 sealed-pair-v1 owner 的显式离线 CLI，未配置时不扫描、不派生进程。
+import { execFile } from "node:child_process";
+import { createHash } from "node:crypto";
+import { readFileSync, lstatSync, realpathSync } from "node:fs";
+import path from "node:path";
+import { promisify } from "node:util";
+import type { ExtensionContext } from "@earendil-works/pi-coding-agent";
+
+const execute = promisify(execFile);
+const ID = /^[A-Za-z0-9][A-Za-z0-9_.-]{0,119}$/;
+const SHA = /^[a-f0-9]{64}$/;
+const HELP = "用法：/goal-snapshot status | save <id> [parent] | restore <id> <新目录名>";
+const digest = (bytes: Buffer) => createHash("sha256").update(bytes).digest("hex");
+
+export async function runShadowSnapshotCommand(rawArgs: string, ctx: ExtensionContext): Promise<void> {
+	const fields = rawArgs.trim().split(/\s+/).filter(Boolean);
+	if (!(fields.length === 1 && fields[0] === "status") &&
+		!(fields[0] === "save" && fields.length >= 2 && fields.length <= 3 && fields.slice(1).every((x) => ID.test(x))) &&
+		!(fields[0] === "restore" && fields.length === 3 && fields.slice(1).every((x) => ID.test(x)) && !fields[2].startsWith("."))) {
+		ctx.ui.notify(HELP, "warning");
+		return;
+	}
+	const config = process.env.VIBE_GOAL_SNAPSHOT_CONFIG;
+	const session = process.env.VIBE_GOAL_SNAPSHOT_SESSION_ID;
+	const cliHash = process.env.VIBE_GOAL_SNAPSHOT_CLI_SHA256;
+	const storeHash = process.env.VIBE_GOAL_SNAPSHOT_STORE_SHA256;
+	const pythonHash = process.env.VIBE_GOAL_SNAPSHOT_PYTHON_SHA256;
+	const zstdHash = process.env.VIBE_GOAL_SNAPSHOT_ZSTD_SHA256;
+	if (![config, session, cliHash, storeHash, pythonHash, zstdHash].some(Boolean)) {
+		ctx.ui.notify("goal-snapshot 未配置；没有扫描或写入任何研究文件。", "info");
+		return;
+	}
+	if (!config || !session || ![cliHash, storeHash, pythonHash, zstdHash].every((x) => typeof x === "string" && SHA.test(x)) || !path.isAbsolute(config)) {
+		ctx.ui.notify("goal-snapshot BLOCK: 配置/依赖摘要不完整。", "warning");
+		return;
+	}
+	if (ctx.isProjectTrusted?.() !== true || ctx.sessionManager.getSessionId() !== session ||
+		!path.isAbsolute(ctx.cwd) || realpathSync(ctx.cwd) !== ctx.cwd) {
+		ctx.ui.notify("goal-snapshot BLOCK: 项目或会话不受信。", "warning");
+		return;
+	}
+	try {
+		const info = lstatSync(config);
+		const owner = process.getuid?.();
+		if (owner === undefined || !info.isFile() || info.isSymbolicLink() || info.uid !== owner ||
+			(info.mode & 0o077) !== 0 || info.size > 16 * 1024 || realpathSync(config) !== config) throw new Error("config");
+		const bytes = readFileSync(config);
+		if (bytes.length > 16 * 1024 || JSON.parse(bytes.toString("utf8")).repository_root !== ctx.cwd) throw new Error("cwd");
+		const configHash = digest(bytes);
+		const verify = (file: string, hash: string, limit: number, owners: number[]) => {
+			const state = lstatSync(file);
+			if (!state.isFile() || state.isSymbolicLink() || state.size > limit || !owners.includes(state.uid) ||
+				realpathSync(file) !== file || digest(readFileSync(file)) !== hash) throw new Error("executable drift");
+		};
+		const bridge = path.join(ctx.cwd, "scripts/goal_shadow_bridge.py");
+		const store = path.join(ctx.cwd, "scripts/goal_snapshot_store.py");
+		verify(bridge, cliHash!, 256 * 1024, [owner]);
+		verify(store, storeHash!, 256 * 1024, [owner]);
+		const python = realpathSync("/usr/bin/python3");
+		verify(python, pythonHash!, 16 * 1024 * 1024, [0, 65534]);
+		verify("/usr/bin/zstd", zstdHash!, 8 * 1024 * 1024, [0, 65534]);
+		const result = await execute(python, ["-I", "-S", "-B", bridge, "--config", config,
+			"--expected-config-sha256", configHash, ...fields], {
+			timeout: 45_000, maxBuffer: 8 * 1024,
+			env: { PATH: "/usr/bin:/bin", PYTHONDONTWRITEBYTECODE: "1" },
+		});
+		const receipt = JSON.parse(result.stdout.trim());
+		if (!receipt || receipt.candidate_only !== true) throw new Error("receipt");
+		// 不把私密路径、源正文、子进程 stderr 或异常复制进 Goal/session。
+		ctx.ui.notify(`goal-snapshot ${fields[0]}: candidate_only；请在私密终端核对完整回执。`, "info");
+	} catch {
+		ctx.ui.notify("goal-snapshot BLOCK: 离线影子 CLI 拒绝操作；请在隔离终端检查非零退出。", "warning");
+	}
+}
