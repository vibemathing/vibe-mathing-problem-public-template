{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-mathing.local/schema/research-os-profile.v1.json",
  "title": "Vibe Mathing public Research OS capability profile v1",
  "description": "Public-template capability inventory. It is candidate-only and never a mathematical truth or production-readiness claim.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "profile_id",
    "status",
    "claim_boundary",
    "problem_scope",
    "capabilities",
    "deferred_capabilities",
    "gates",
    "validation_commands",
    "non_claims"
  ],
  "properties": {
    "$schema": {"type": "string", "format": "uri"},
    "schema_version": {"const": "1.0.0"},
    "profile_id": {"const": "research-os-public-template-v1"},
    "status": {"enum": ["pilot", "blocked", "not_ready"]},
    "claim_boundary": {"const": "candidate_only_no_mathematical_truth"},
    "problem_scope": {"const": "single_problem_contract"},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/capability"}
    },
    "deferred_capabilities": {
      "type": "array",
      "maxItems": 64,
      "items": {"$ref": "#/$defs/deferredCapability"}
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"$ref": "#/$defs/gate"}
    },
    "validation_commands": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 300}
    },
    "non_claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 600}
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_id",
        "kind",
        "owner",
        "status",
        "source",
        "source_sha256",
        "evidence_ceiling",
        "side_effect_policy",
        "validation_commands"
      ],
      "properties": {
        "capability_id": {"type": "string", "pattern": "^ros\\.[a-z0-9][a-z0-9.-]*$"},
        "kind": {"enum": ["schema", "validator", "runtime", "cli", "test"]},
        "owner": {"const": "problem-repository-harness"},
        "status": {"const": "implemented_isolated"},
        "source": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9._/-]+$"
        },
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "evidence_ceiling": {"enum": ["candidate_only", "control_plane_only"]},
        "side_effect_policy": {"enum": ["read_only", "isolated_event_ledger_only"]},
        "validation_commands": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 300}
        }
      }
    },
    "deferredCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability_id", "status", "reason", "trigger"],
      "properties": {
        "capability_id": {"type": "string", "pattern": "^ros\\.[a-z0-9][a-z0-9.-]*$"},
        "status": {"enum": ["deferred", "blocked"]},
        "reason": {"type": "string", "minLength": 1, "maxLength": 600},
        "trigger": {"type": "string", "minLength": 1, "maxLength": 600}
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_id", "title", "status", "checks"],
      "properties": {
        "gate_id": {"type": "string", "pattern": "^gate\\.[a-z0-9][a-z0-9.-]*$"},
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "status": {"enum": ["enforced", "open", "blocked", "deferred", "not_applicable"]},
        "checks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 400}
        }
      }
    }
  }
}
