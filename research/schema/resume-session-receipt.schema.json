{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-mathing.local/schema/resume-session-receipt.schema.json",
  "title": "Vibe Mathing Verified Resume Session Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "session_id", "worker_id", "task_id", "problem_id",
    "goal_digest", "provider_fingerprint", "verification_method", "verified_at", "expires_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "session_id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_.:-]+$"},
    "worker_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "problem_id": {"type": "string", "pattern": "^problem:[a-z0-9][a-z0-9.-]*$"},
    "goal_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "provider_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "verification_method": {"const": "operator_resume_map"},
    "verified_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "source_ref": {"type": "string", "minLength": 1}
  }
}
