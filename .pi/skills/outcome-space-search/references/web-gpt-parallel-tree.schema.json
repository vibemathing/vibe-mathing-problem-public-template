{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-mathing.local/schema/web-gpt-parallel-outcome-tree.v1.json",
  "title": "Web GPT parallel outcome classification tree v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_role",
    "classification_rule",
    "lane_count",
    "classifier_dimensions",
    "assignment_precedence",
    "assignment_rules",
    "lanes",
    "scope_overlay",
    "search_unit_contract",
    "concurrency_projection",
    "atomicity_rules",
    "hit_semantics",
    "non_claims"
  ],
  "properties": {
    "schema_version": {"const": "web-gpt-parallel-outcome-tree.v1"},
    "artifact_role": {"const": "candidate-classification-only"},
    "classification_rule": {"const": "first-match-by-assignment-precedence"},
    "lane_count": {"const": 9},
    "classifier_dimensions": {"$ref": "#/$defs/classifierDimensions"},
    "assignment_precedence": {"$ref": "#/$defs/allLaneIds"},
    "assignment_rules": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {"$ref": "#/$defs/assignmentRule"}
    },
    "lanes": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {"$ref": "#/$defs/lane"}
    },
    "scope_overlay": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {
        "enum": [
          "exact",
          "special",
          "conditional",
          "generalized",
          "strengthened",
          "weakened",
          "incomparable"
        ]
      }
    },
    "search_unit_contract": {"$ref": "#/$defs/searchUnitContract"},
    "concurrency_projection": {"$ref": "#/$defs/concurrencyProjection"},
    "atomicity_rules": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 10, "maxLength": 500}
    },
    "hit_semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root_closure_candidate", "local_progress", "search_reduction", "replan_trigger"],
      "properties": {
        "root_closure_candidate": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"pattern": "^T[1-9]$"}},
        "local_progress": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"pattern": "^T[1-9]$"}},
        "search_reduction": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"pattern": "^T[1-9]$"}},
        "replan_trigger": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"pattern": "^T[1-9]$"}}
      }
    },
    "non_claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorizes_concurrency", "creates_web_tasks", "creates_evidence", "creates_result", "claims_exhaustive_mathematics"],
      "properties": {
        "authorizes_concurrency": {"const": false},
        "creates_web_tasks": {"const": false},
        "creates_evidence": {"const": false},
        "creates_result": {"const": false},
        "claims_exhaustive_mathematics": {"const": false}
      }
    }
  },
  "$defs": {
    "laneId": {"type": "string", "pattern": "^T[1-9]$"},
    "allLaneIds": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/laneId"}
    },
    "classifierDimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "effect", "output"],
      "properties": {
        "target": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": {"enum": ["root_problem", "intermediate_mathematics", "route", "semantic_contract", "unclassified"]}
        },
        "effect": {
          "type": "array",
          "minItems": 7,
          "uniqueItems": true,
          "items": {"enum": ["establish", "refute", "advance", "block", "revise", "independence", "unknown"]}
        },
        "output": {
          "type": "array",
          "minItems": 9,
          "uniqueItems": true,
          "items": {"enum": ["proof", "refutation", "relation", "local-assertion", "structure", "quantity", "construction-or-procedure", "negative-route-knowledge", "meta-semantic-or-new-type"]}
        }
      }
    },
    "conditionMap": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "target": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "effect": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "output": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "assignmentRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lane_id", "mode", "conditions"],
      "properties": {
        "lane_id": {"$ref": "#/$defs/laneId"},
        "mode": {"enum": ["all", "any", "fallback"]},
        "conditions": {
          "oneOf": [
            {"$ref": "#/$defs/conditionMap"},
            {"type": "object", "maxProperties": 0}
          ]
        }
      }
    },
    "lane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lane_id", "title_zh", "slug", "primary_target", "primary_effect", "primary_output", "children", "hit_value", "fallback"],
      "properties": {
        "lane_id": {"$ref": "#/$defs/laneId"},
        "title_zh": {"type": "string", "minLength": 2, "maxLength": 80},
        "slug": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,79}$"},
        "primary_target": {
          "enum": ["root_problem", "intermediate_mathematics", "route", "mixed-fallback"]
        },
        "primary_effect": {
          "enum": ["establish", "refute", "advance", "block", "independence-revise-or-classify"]
        },
        "primary_output": {
          "enum": ["proof", "refutation", "relation", "local-assertion", "structure", "quantity", "construction-or-procedure", "negative-route-knowledge", "meta-semantic-or-new-type"]
        },
        "children": {
          "type": "array",
          "minItems": 3,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,79}$"}
        },
        "hit_value": {
          "enum": ["root-closure-candidate", "local-verifiable-progress", "search-space-reduction", "semantic-fix-or-replan"]
        },
        "fallback": {"type": "boolean"}
      }
    },
    "searchUnitContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_fields", "exactly_one_owner", "semantic_digests_required", "subdirections_spawn_tasks", "authorized_by_tree"],
      "properties": {
        "required_fields": {
          "type": "array",
          "minItems": 11,
          "uniqueItems": true,
          "items": {
            "enum": ["lane_id", "outcome_id", "statement", "scope", "closure_predicate", "priority_vector", "owner", "requested_budget", "stop_condition", "input_refs", "expected_artifact"]
          }
        },
        "exactly_one_owner": {"const": true},
        "semantic_digests_required": {"const": true},
        "subdirections_spawn_tasks": {"const": false},
        "authorized_by_tree": {"const": false}
      }
    },
    "concurrencyProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification_slots", "task_candidates_per_slot", "maximum_task_candidates", "subdirections_are_internal"],
      "properties": {
        "classification_slots": {"const": 9},
        "task_candidates_per_slot": {"const": 1},
        "maximum_task_candidates": {"const": 9},
        "subdirections_are_internal": {"const": true}
      }
    }
  }
}
